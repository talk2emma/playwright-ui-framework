{
  "name": "playwright-ui-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Playwright UI automation framework",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:a11y": "playwright test --project=accessibility",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:failed": "playwright test --last-failed",
    "test:trace": "playwright test --trace on",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rimraf test-results reports playwright-report .cache",
    "prepare": "node -e \"if(!process.env.CI)process.exit(1)\" || husky",
    "docs": "npm run docs:api && npm run docs:html && npm run docs:pdf",
    "docs:api": "node scripts/docs/extract-api.mjs",
    "docs:html": "node scripts/docs/build-docs.mjs",
    "docs:pdf": "node scripts/docs/build-pdf.mjs",
    "docs:open": "open docs/site/index.html"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "axe-core": "^4.13.0",
    "axe-html-reporter": "^2.2.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "zod": "^3.25.76"
  }
}
