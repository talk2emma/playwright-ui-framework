# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Target environment: local | dev | qa | staging | prod
TEST_ENV=dev

# Overrides the environment's default baseURL when set
BASE_URL=

# Execution
HEADLESS=true
SLOW_MO=0
WORKERS=
RETRIES=
TIMEOUT_ACTION=15000
TIMEOUT_NAVIGATION=30000
TIMEOUT_EXPECT=10000
TIMEOUT_TEST=60000

# Artifacts: on | off | retain-on-failure | on-first-retry
TRACE=retain-on-failure
VIDEO=retain-on-failure
SCREENSHOT=only-on-failure

# Viewport
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Logging: error | warn | info | debug | trace
LOG_LEVEL=info

# Credentials (per role)
STANDARD_USER=
STANDARD_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=

# API used for test-data seeding
API_BASE_URL=
API_TOKEN=

# Reporting
CI=false
ALLURE_ENABLED=false
